# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unrooted, so both applications are covered: npm hoists to frontend/node_modules, but a workspace
# can end up with one of its own for a version it cannot share.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
# Unrooted for the same reason as node_modules: each application builds into its own directory —
# frontend/club/.next and frontend/market/.next — and a rooted pattern matched neither.
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
