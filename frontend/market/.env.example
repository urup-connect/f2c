# Copy to .env.local. Never commit .env.local.
# Real QA and Production values live in App Service application settings, not here.

# Django API as reached from the Next.js server (server components, SSR).
# Production: https://backend.f2c.co.za
DJANGO_API_URL=http://localhost:8000

# Django API as reached from the browser. Must be publicly resolvable, and must sit inside the SAME
# registrable domain the browser uses for this app — localhost with localhost, not 127.0.0.1; and in
# production backend.f2c.co.za with f2c.co.za — or the request is cross-site and the
# SameSite=Lax session cookie is not sent. See design/conflict.md C30.
#
# **Read at request time, not at build time.** It used to be NEXT_PUBLIC_DJANGO_API_URL, which
# `next build` inlined into the browser bundle and which therefore tied every image to one
# environment. The root layout now renders it into the document and `lib/api.ts` reads it there,
# so one image can be promoted from QA to Production — see `lib/api-address.ts`. There is no
# default: a deployment that omits this fails on the first request rather than sending every
# shopper's browser to their own machine.
# Production: https://backend.f2c.co.za
DJANGO_API_PUBLIC_URL=http://localhost:8000

# Which deployment this is: local | qa | production.
# Search engine indexing is permitted only when this reads "production".
APP_ENV=local

# Absolute origin this deployment is served from. Scheme and host only, no path.
# This is what robots.txt, the sitemap and every canonical URL are built from, so it must be the
# canonical name — whichever of the apex or www the redirect points at.
# The store runs on 3001 locally so it can run alongside the club on 3000.
# Production: https://f2c.co.za
SITE_URL=http://localhost:3001

# There is deliberately no CDN_BASE_URL here. The club reads one for its landing film; nothing in
# the store is served from the static host — document addresses come from Django, because Django
# owns their revisions. See lib/site.ts.
