# Copy to .env and fill in. Never commit the real .env.

# Required. Generate with:
#   poetry run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Defaults to False when unset. Never True outside local development.
DJANGO_DEBUG=False

# Comma-separated. Required when DJANGO_DEBUG is False.
#
# One deployment answers on both API hosts -- see the Storefronts block below and
# design/conflict.md C30:
#   DJANGO_ALLOWED_HOSTS=backend.f2c.co.za,backend.f2c-cannabis.co.za
DJANGO_ALLOWED_HOSTS=

# Database
# --------
# DJANGO_ENV decides this before any of the variables below are read. `dev` and
# `test` are SQLite unconditionally -- the MySQL settings are ignored, not
# half-applied -- and only `qa` and `prod` connect to a server. Unset means
# `dev`, so a deployment that forgets this variable runs on a local file with a
# fully configured MySQL sitting next to it, unused. Anything other than these
# four is refused.
DJANGO_ENV=dev

# Leave DJANGO_DB_HOST blank for local development: everything falls back to the
# SQLite file at db.sqlite3 and the whole suite runs with no database server at
# all. Setting it switches to MySQL, and then the name and the user are required
# -- see f2c/database.py.
#
# QA and production are MySQL 8.4. Two things about that are not negotiable and
# are enforced rather than documented:
#
#   * 8.0.16 is the hard floor. Before it MySQL parses CHECK and discards it,
#     which would silently unenforce every check constraint in the project.
#   * MariaDB is refused at any version -- it builds no expression index, and
#     Django omits a constraint the backend cannot build without raising.
#
# `manage.py migrate` checks both and stops. See design/backend.md section 8 and
# app/common/checks.py.
#
# The driver (mysqlclient) installs with everything else. Note that its wheels
# are Windows-only, so a Linux host builds it from source and needs:
#   sudo apt-get install -y pkg-config default-libmysqlclient-dev build-essential
DJANGO_DB_HOST=
DJANGO_DB_PORT=3306
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=

# Transport security, and a deployed MySQL has to say which of these it wants.
# **Both stay blank for local development** -- with DJANGO_DB_HOST empty this is
# SQLite and `tls_options` is never reached. They matter when DJANGO_DB_HOST
# names a server.
#
# There is no default because mysqlclient already has one and it is the wrong
# one: `ssl_mode=PREFERRED` connects, encrypts, verifies nothing, and looks
# identical in every log to a connection that checked the certificate. Azure
# Database for MySQL Flexible Server runs `require_secure_transport=ON`, so the
# unverified connection succeeds and nobody finds out. So `tls_options` refuses
# a deployed MySQL that names neither, and refuses one that names both rather
# than resolving them.
#
# **QA and production set DJANGO_DB_SSL_DISABLED=true**, and the name overstates
# it: verification is off, encryption is not. The connection still comes up over
# TLS under mysqlclient's PREFERRED; what is given up is the check on which
# server answered. Trust rests on the network instead -- the Flexible Server
# firewall admits Azure services and a named list of IPs and nothing else, and
# the application user authenticates with a password. design/deploy.md section 8
# is where that arrangement is written down.
#
# Set this the same way for a local or containerised MySQL with no certificate
# of its own -- CI does exactly that.
DJANGO_DB_SSL_DISABLED=

# The other spelling, and the one to reach for if verification is ever wanted
# back. Name the CA bundle the server's certificate chains to; on Azure the
# runtime image's own `/etc/ssl/certs/ca-certificates.crt` already carries the
# DigiCert roots Flexible Server uses:
#   DJANGO_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# That turns on ssl_mode=VERIFY_IDENTITY -- certificate AND hostname. VERIFY_CA
# is not enough; it accepts a valid certificate issued for another server.
DJANGO_DB_SSL_CA=

# Behind a proxy
# --------------
# **One variable, three consequences.** Set this to true whenever anything sits
# between the internet and Django -- Azure Container Apps ingress, App Service,
# a load balancer, a CDN. It tells Django to believe X-Forwarded-Proto (so
# SECURE_SSL_REDIRECT does not loop on a request that already arrived over
# HTTPS), and it tells the Payfast notification endpoint to read the caller's
# address from X-Forwarded-For instead of REMOTE_ADDR.
#
# Leaving it unset behind a proxy is the worst-shaped failure in the deployment:
# checkout succeeds, the member is charged, and every notification is rejected,
# so no membership is ever activated. `manage.py check --deploy` refuses to pass
# without it (payments.W001), and the container entrypoint runs that as a gate.
#
# **Only safe when the edge OVERWRITES X-Forwarded-For.** An edge that appends
# to whatever arrived lets a caller prepend an address of their choosing. Azure
# Front Door and Application Gateway overwrite; a container reachable directly
# does not, and must leave this unset.
DJANGO_BEHIND_PROXY=

# An override for the one deployment where the two halves differ: an edge that
# terminates TLS (so Django should trust the scheme) but appends to
# X-Forwarded-For (so the source check must not trust it). Leave blank unless
# that is genuinely the case -- blank means "follow DJANGO_BEHIND_PROXY".
DJANGO_PAYFAST_BEHIND_PROXY=

# HTTPS enforcement. Both derive sensible values from DJANGO_BEHIND_PROXY and
# DJANGO_DEBUG, so a normal deployment sets neither. HSTS defaults to a year.
# SECURE_HSTS_PRELOAD is deliberately never set: the preload list is close to
# irreversible and covers subdomains this project does not serve.
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SECURE_HSTS_SECONDS=
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=

# Cache and the task queue
# ------------------------
# **One Redis, two users.** The throttle counters are in database 0 and the
# Celery broker is in database 1, derived from the URL below rather than
# configured separately -- so a deployment provisions one Redis and gets both.
# The queue runs the three scheduled jobs: `lapse_memberships`, which withdraws
# access from a membership that has stopped paying, and the two retention
# purges. See f2c/queue.py.
#
# The throttle counters live here and nothing else does. That makes this a
# correctness setting rather than a performance one: a cache each process keeps
# to itself turns every published rate limit into that limit multiplied by the
# process count, silently, and the limit on otp/start is what stops the API
# being used to mailbomb a member.
#
# QA and production are Azure Managed Redis and refuse to start without it.
# Locally, `docker compose up -d redis` and point this at it; leave it blank and
# the application falls back to LocMemCache, which is correct in a single
# process and wrong in any other. See f2c/cache.py.
#
#   local: redis://localhost:6379/0
#   qa and production: rediss://:<access-key>@<name>.<region>.redis.azure.net:10000/0
#
# rediss:// is required in qa and prod. The access key travels inside this URL,
# so plaintext there either puts it on the wire or is pointing somewhere that is
# not the managed instance. Azure Managed Redis serves TLS on port 10000.
DJANGO_REDIS_URL=

# Permits redis:// where rediss:// is required. For CI against a Redis container
# on the runner's own loopback, with no key in the URL and no network to cross.
# Not for a deployment.
#
# **This governs the cache and the queue together, deliberately.** It describes
# one deployment fact -- this Redis is on the machine, carries no access key and
# crosses no network -- and one fact gets one variable. A separate switch for the
# queue could only fail by disagreeing with this one, and the shape of that
# failure is a TLS cache beside a plaintext queue sending the same key in clear.
DJANGO_CACHE_ALLOW_PLAINTEXT=

# The Celery broker, for the deployment that wants the queue on its own Redis
# instead of database 1 of the one above. Leave it blank and the broker is
# derived from DJANGO_REDIS_URL, which is what every environment does today.
#
# Blank with DJANGO_REDIS_URL also blank means eager execution: every task runs
# inline at the point it is called, which is the developer-with-no-container
# fallback and what the test suite runs on. qa and prod refuse it -- eager there
# would mean beat publishing into nothing, the three nightly jobs silently never
# running, and every email sent from inside the request that composed it.
#
# **Every outbound email goes through this broker**, including the sign-in
# codes. Locally that is what the compose stack's celery-mail service consumes;
# with no broker at all, sends happen inline and nothing needs to be running.
#
#   local: leave blank
#   qa and production: leave blank, or rediss://:<key>@<host>:10000/1
DJANGO_CELERY_BROKER_URL=

# How many messages the mail worker sends at once. Read by
# deploy/entrypoint.sh, not by Django, and only by the mail-worker container --
# the scheduled worker is fixed at one, because two purges at once is the
# arrangement the beat schedule was written to avoid.
#
# Four by default. The work is a blocking socket read against a mail server, so
# one process waiting out an unresponsive provider should not stop three others
# sending. Raise it when send volume says so; there is no code change involved.
#
#   local: leave blank
#   qa and production: leave blank unless send volume needs more
CELERY_MAIL_CONCURRENCY=

# Comma-separated, scheme included. Must include every Next.js origin that POSTs.
# Defaults to localhost:3000 when DEBUG=True.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://f2c.co.za,https://f2c-cannabis.co.za
DJANGO_CSRF_TRUSTED_ORIGINS=

# Origins allowed to call the API from a browser (the Next.js frontends).
# Comma-separated, scheme included. Defaults to localhost:3000 when DEBUG=True.
# The store and the club are separate origins and both are listed:
#   DJANGO_CORS_ALLOWED_ORIGINS=https://f2c.co.za,https://f2c-cannabis.co.za
DJANGO_CORS_ALLOWED_ORIGINS=

# Passkeys (WebAuthn)
# ------------------
# The Relying Party ID: the registrable domain the FRONTEND is served from,
# never a URL and never an IP address. It must equal the frontend hostname or
# be a parent of it. Defaults to "localhost" when DJANGO_DEBUG=True, which is
# why local sign-in must happen at http://localhost:3000 and not 127.0.0.1.
# Set it to the storefront that is not listed in DJANGO_WEBAUTHN_RP_IDS below, or
# to the default storefront's domain when both are listed.
# Example for production: f2c-cannabis.co.za
# ---------------------------------------------------------------------------
# Storefronts
# ---------------------------------------------------------------------------
# Which storefront each host serves, as host=storefront pairs separated by
# commas. The club and the produce market sit on separate registrable domains,
# and two endpoints have no session to scope themselves by -- the public
# document list and the sign-up document list are both unauthenticated by
# necessity, so the host is what is left. See app/storefronts/resolution.py.
#
# **These are the hosts DJANGO answers on, not the hosts the browser shows.**
# The frontend's name never reaches Django; request.get_host() is the API host.
# Under C30 the store is f2c.co.za and the club is f2c-cannabis.co.za, and each
# calls the API inside its own registrable domain so the SameSite=Lax session
# cookie is not cross-site:
#
#   DJANGO_STOREFRONT_HOSTS=backend.f2c.co.za=market,backend.f2c-cannabis.co.za=club
#
# Blank is fine in development: every host falls back to DEFAULT_STOREFRONT.
DJANGO_STOREFRONT_HOSTS=

# Where an unmapped host lands. Leave as club unless the market becomes the
# primary deployment.
DJANGO_DEFAULT_STOREFRONT=club

DJANGO_WEBAUTHN_RP_ID=

# The RP ID per storefront, as storefront=domain pairs. A passkey does not cross a
# registrable domain, so a member of both storefronts enrols one at each; the
# emailed code works anywhere. These are the FRONTEND domains -- C30:
#
#   DJANGO_WEBAUTHN_RP_IDS=club=f2c-cannabis.co.za,market=f2c.co.za
#
# Anything unlisted falls back to DJANGO_WEBAUTHN_RP_ID above, which is what keeps
# a single-storefront deployment configured exactly as it was.
DJANGO_WEBAUTHN_RP_IDS=

# Shown by the authenticator when it asks the member to confirm.
DJANGO_WEBAUTHN_RP_NAME=Cultivators Collective

# Full frontend origins allowed to present credentials, comma-separated and
# scheme-included. Normally the same list as DJANGO_CORS_ALLOWED_ORIGINS.
# Defaults to http://localhost:3000 when DJANGO_DEBUG=True.
#   DJANGO_WEBAUTHN_ORIGINS=https://f2c.co.za,https://f2c-cannabis.co.za
DJANGO_WEBAUTHN_ORIGINS=

# Fallback sender address, used only where a storefront names none of its own --
# which outside local development it always must. See the email block below.
DJANGO_DEFAULT_FROM_EMAIL=no-reply@f2c.co.za

# Field-level encryption
# ----------------------
# Two independent 32-byte secrets, base64. Generate each with:
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep them out of source control and out of DJANGO_SECRET_KEY's rotation:
# rotating the secret key must not make stored ID numbers unreadable.

# Encrypts identity-document numbers at rest (AES-256-GCM).
# Lose it and every stored ID number is unrecoverable. There is no backup path.
DJANGO_FIELD_ENCRYPTION_KEY=

# Keys the searchable digests of ID numbers and email addresses. Changing it
# invalidates every stored digest, so the uniqueness check on ID numbers and
# the "has this address been seen before" lookup would both need a rebuild.
DJANGO_BLIND_INDEX_PEPPER=

# Club documents and the CDN
# --------------------------
# Where the documents a member agrees to are stored, and the address they are
# served from. Azure Blob Storage, fronted by the CDN. See documents/storage.py
# for the reader and documents/models.py for what is recorded per revision.
#
# Leave DJANGO_DOCUMENT_STORAGE_CONTAINER blank for local development: uploads
# then go to MEDIA_ROOT and runserver serves them, so the whole feature works
# with no Azure account at all. Everything else in this block is ignored while
# it is blank.

# Public prefix the CDN serves the documents from: scheme, host, and at most the
# container as its path. No trailing slash. Must be https anywhere but local
# development -- a document fetched over plain http is a document anything on the
# network path can rewrite.
#
# An Azure blob URL always carries the container as its first path segment, and
# only the host is swapped for this one. So if the path is set it must match the
# container name exactly, and startup fails if it does not -- otherwise every
# document link points at an address that does not exist.
# Example: https://qa-static.urup.com/consumer-collective
DJANGO_CDN_BASE_URL=

# The blob container the CDN fronts. Setting this switches uploads from local
# disk to Azure.
# Example: consumer-collective
DJANGO_DOCUMENT_STORAGE_CONTAINER=

# The storage account the container belongs to -- the name alone, not a URL.
# Required unless DJANGO_DOCUMENT_STORAGE_CONNECTION_STRING is set instead.
DJANGO_DOCUMENT_STORAGE_ACCOUNT=

# How to authenticate to that account. Pick one, in this order of preference:
#
# 1. Nothing at all. With an account set and no secret here, the container is
#    reached with a managed identity -- which is what QA and Production should
#    use. Assign the App Service identity the "Storage Blob Data Contributor"
#    role on the container; no secret goes into application settings, and there
#    is nothing to rotate.
#
# 2. An account key, for a developer writing against a real container. Grants
#    full control of the whole account, so keep it out of shared environments.
#
# 3. A SAS token, where a key is too much authority. Needs write permission on
#    the container, and expires -- uploads start failing the day it does.
#
# A connection string carries the account and the key together and overrides
# DJANGO_DOCUMENT_STORAGE_ACCOUNT. Convenient locally, a secret like any other.
DJANGO_DOCUMENT_STORAGE_ACCOUNT_KEY=
DJANGO_DOCUMENT_STORAGE_SAS_TOKEN=
DJANGO_DOCUMENT_STORAGE_CONNECTION_STRING=

# Blob-name prefix inside the container, for a container shared with other
# content. Normally blank: the documents already live under a "documents/"
# prefix of their own, which this would sit in front of.
DJANGO_DOCUMENT_STORAGE_LOCATION=

# Member avatars
# --------------
# Where a member's own photograph is stored. A *separate, private* container from
# the documents above, and the separation is the whole point: a club document is
# published to everybody, and an avatar is a photograph of somebody's face.
#
# There is deliberately no CDN variable in this block. The container has no public
# access and no SAS is minted, so an avatar has exactly one address --
# GET /api/accounts/me/avatar, which checks the session before it streams a byte.
# Startup fails if this names the same container as the documents, because that
# mistake would publish every member's photograph. See accounts/storage.py.
#
# Leave DJANGO_AVATAR_STORAGE_CONTAINER blank for local development: uploads then
# go to MEDIA_ROOT and the whole feature -- crop, upload, replace, serve -- works
# with no Azure account at all. Everything else in this block is ignored while it
# is blank.
#
# Note the local caveat: under DEBUG, runserver's static handler will serve a file
# from MEDIA_ROOT to anybody who guesses the path. Acceptable on a developer's
# machine and nowhere else -- a deployment either sets a private container here or
# puts a web server on MEDIA_URL that does not serve the avatars/ prefix.

# A private blob container, distinct from the documents one. Setting this switches
# avatar uploads from local disk to Azure.
# Example: consumer-collective-avatars
DJANGO_AVATAR_STORAGE_CONTAINER=

# The storage account the container belongs to -- the name alone, not a URL.
# Required unless DJANGO_AVATAR_STORAGE_CONNECTION_STRING is set instead.
DJANGO_AVATAR_STORAGE_ACCOUNT=

# How to authenticate, in the same order of preference as the documents block
# above and for the same reasons: nothing at all (managed identity, and what QA
# and Production should use), then an account key, then a SAS token.
DJANGO_AVATAR_STORAGE_ACCOUNT_KEY=
DJANGO_AVATAR_STORAGE_SAS_TOKEN=
DJANGO_AVATAR_STORAGE_CONNECTION_STRING=

# Blob-name prefix inside the container. Normally blank: avatars already live
# under an "avatars/" prefix of their own.
DJANGO_AVATAR_STORAGE_LOCATION=

# Payments: Payfast
# -----------------
# The membership subscription and the gateway that bills it. See app/payments/
# gateway.py for the reader that validates every variable below, and
# design/features/payments.md for what a payment does to an account.
#
# Leave DJANGO_PAYFAST_MERCHANT_ID and _KEY blank for local development: the
# reader then falls back to Payfast's own published sandbox merchant, so the
# whole flow works with no account at all. With DJANGO_DEBUG=False every
# variable here is required and Django refuses to start without it -- a payment
# integration that silently falls back to a sandbox is one that takes a
# member's money into an account nobody is watching.
#
# One thing configuration cannot fix locally: Payfast delivers notifications
# server-to-server and cannot reach a localhost notify URL, so the step that
# activates a membership never fires on a developer's machine. Use
#   manage.py payfast_notify --email someone@example.com
# which signs a real payload and runs it through the real verification.

# From the Payfast dashboard. The key is a secret and belongs in application
# settings, never in source control.
DJANGO_PAYFAST_MERCHANT_ID=
DJANGO_PAYFAST_MERCHANT_KEY=

# Set a passphrase on the Payfast account (Settings > Security) and put the same
# value here. Required, and not only for the signature: Payfast refuses
# subscriptions outright from a merchant that has none.
DJANGO_PAYFAST_PASSPHRASE=

# Which Payfast to talk to. Defaults to the sandbox when unset, in every
# environment -- live is never reached by leaving a variable blank. Set this to
# true only when the deployment means to take real money.
DJANGO_PAYFAST_SANDBOX=true

# Where Payfast sends the member's browser afterwards. Frontend addresses, and
# https anywhere but local development -- a payment redirect over plain http is
# one anything on the network path can rewrite.
DJANGO_PAYFAST_RETURN_URL=
DJANGO_PAYFAST_CANCEL_URL=

# Where Payfast notifies this application, server-to-server. Django's own public
# address, not the frontend's, and it must be reachable from the internet: this
# is the only thing that activates a membership.
DJANGO_PAYFAST_NOTIFY_URL=

# The frontend page a checkout token is paid from, without the token. The link
# emailed to a member with an outstanding payment is this plus their token.
DJANGO_MEMBERSHIP_CHECKOUT_URL=

# Set this only where the notification endpoint sits behind a reverse proxy that
# OVERWRITES X-Forwarded-For (Azure Front Door and Application Gateway both do).
# An origin that appends to whatever arrived lets a caller prepend an address of
# their choosing and walk straight through the source check, which is why
# reading that header is opt-in rather than automatic.
#
# **Set DJANGO_BEHIND_PROXY instead**, in the "Behind a proxy" block above. It
# covers this and Django's own HTTPS handling, because they are the same fact.
# The variable here remains as an override and is documented there.

# What a membership costs and how often it is billed. The amount is rands and
# cents; there is no free tier and 0 is refused. Frequency is one of monthly,
# quarterly, biannual, annual. Cycles is a whole number of billings, or 0 for
# "until the member cancels".
#
# Changing the amount changes what NEW members are asked for and nothing about
# what existing ones agreed to: the price is copied onto each subscription when
# it is opened. See app/payments/models.py.
DJANGO_MEMBERSHIP_SUBSCRIPTION_AMOUNT=150.00
DJANGO_MEMBERSHIP_SUBSCRIPTION_FREQUENCY=monthly
DJANGO_MEMBERSHIP_SUBSCRIPTION_CYCLES=0

# What the member sees on the Payfast page and on their bank statement. Says
# what it is and nothing about cultivation.
DJANGO_MEMBERSHIP_SUBSCRIPTION_ITEM_NAME=Club membership
DJANGO_MEMBERSHIP_SUBSCRIPTION_DESCRIPTION=Cultivators Collective membership subscription

# Email: two servers, one per storefront
# -------------------------------------
# The club and the produce market are separate businesses on separate domains
# with separate mailbox providers, so they send through separate SMTP servers.
# EMAIL_CC_* is the club (Cultivators Collective). EMAIL_F2C_* is the store (the
# produce market). Which one sends a given email is decided by the storefront the
# message belongs to, and that includes the sign-in code: a code requested on the
# store's domain leaves the store's server, signed with the store's name. See
# app/core/storefronts/mail.py.
#
# Leave both HOSTs blank for local development: every storefront then prints its
# mail to the console and the whole flow -- sign-in codes included -- works with
# no mail server at all. Everything else in this block is ignored while they are.
#
# With DJANGO_DEBUG=False both HOSTs and both FROMs are required and Django
# refuses to start without them. There is deliberately no fallback to the other
# storefront's server: it would send successfully, so nothing would look wrong,
# and members of one storefront would be receiving mail from a provider that has
# no business holding their address.

# The club's SMTP server.
EMAIL_CC_HOST=
# Defaults to 587 with TLS, 465 with SSL.
EMAIL_CC_PORT=
EMAIL_CC_USER=
EMAIL_CC_PASSWORD=
# STARTTLS on 587. Defaults to true -- an SMTP password does not cross the
# network in cleartext because a variable was left blank. Set only one of these.
EMAIL_CC_USE_TLS=true
# Implicit TLS on 465, which is what several South African providers offer.
EMAIL_CC_USE_SSL=
# The address members see. Normally has to be one the provider above is
# authorised to send for, which is why it is per-server and not shared.
# Example: no-reply@f2c-cannabis.co.za
EMAIL_CC_FROM=

# The store's SMTP server. Same rules as the club's above.
EMAIL_F2C_HOST=
EMAIL_F2C_PORT=
EMAIL_F2C_USER=
EMAIL_F2C_PASSWORD=
EMAIL_F2C_USE_TLS=true
EMAIL_F2C_USE_SSL=
# Example: no-reply@f2c.co.za
EMAIL_F2C_FROM=

# How many days of send history to keep. Every email the platform sends is
# recorded -- which member, which message, when, and whether the mail server
# took it -- so that "was the member told?" is answerable without a mail
# provider's console. The record holds no email address and no message body: it
# points at the account, which is what makes an erased account's send history
# de-identify itself.
#
# Twelve months by default, which is the longest-lived question the log answers
# (a dispute over a suspension notice). Nothing enforces it on its own: put
# `manage.py purge_email_dispatches` on the same nightly timer as the rest of
# the housekeeping. Set to 0 to keep everything and disable the purge.
#
# Delivery and read tracking are deliberately *not* in this: plain SMTP cannot
# report whether a message arrived, and reading is only knowable through an
# invisible image in the body, which is not something to put in a one-time code.
# The columns exist and stay empty. Configuring a provider that reports events
# back is what fills them -- see EmailDispatch.apply_provider_event.
EMAIL_DISPATCH_RETENTION_DAYS=365

# How many days of campaign tracking to keep. A member who arrived on a tagged
# link -- utm_source, utm_campaign and the rest -- has the campaign that found
# them and the one they joined on recorded against their membership, so that
# "which channel brings us members" is answerable without an analytics product
# holding the club's member list.
#
# Two years by default, which is the shortest window that allows a campaign to
# be compared against the same campaign last year. Nothing enforces it on its
# own: put `manage.py purge_campaign_touches` on the same nightly timer as the
# send-record purge. Set to 0 to keep everything and disable the purge.
#
# What is stored is the labels the club wrote into its own links, the referring
# site, the landing path and a timestamp -- no visitor id, no IP address, no
# third-party pixel, and nothing at all for a visitor who never registers.
# Purging deletes the campaign and keeps the member: their attribution goes
# back to "not known".
CAMPAIGN_TOUCH_RETENTION_DAYS=730
