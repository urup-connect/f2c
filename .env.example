# Copy to .env and fill in. Never commit the real .env.

# Required. Generate with:
#   poetry run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Defaults to False when unset. Never True outside local development.
DJANGO_DEBUG=False

# Comma-separated. Required when DJANGO_DEBUG is False.
DJANGO_ALLOWED_HOSTS=

# Database
# --------
# Leave DJANGO_DB_HOST blank for local development: everything falls back to the
# SQLite file at db.sqlite3 and the whole suite runs with no database server at
# all. Setting it switches to MySQL, and then the name and the user are required
# -- see cultivatorscollective/database.py.
#
# QA and production are MySQL 8.4. Two things about that are not negotiable and
# are enforced rather than documented:
#
#   * 8.0.16 is the hard floor. Before it MySQL parses CHECK and discards it,
#     which would silently unenforce every check constraint in the project.
#   * MariaDB is refused at any version -- it builds no expression index, and
#     Django omits a constraint the backend cannot build without raising.
#
# `manage.py migrate` checks both and stops. See design/backend.md section 8 and
# app/common/checks.py.
#
# The driver (mysqlclient) installs with everything else. Note that its wheels
# are Windows-only, so a Linux host builds it from source and needs:
#   sudo apt-get install -y pkg-config default-libmysqlclient-dev build-essential
DJANGO_DB_HOST=
DJANGO_DB_PORT=3306
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=

# Comma-separated, scheme included, e.g. https://cultivatorscollective.co.za
# Must include the Next.js origin. Defaults to localhost:3000 when DEBUG=True.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Origins allowed to call the API from a browser (the Next.js frontend).
# Comma-separated, scheme included. Defaults to localhost:3000 when DEBUG=True.
DJANGO_CORS_ALLOWED_ORIGINS=

# Passkeys (WebAuthn)
# ------------------
# The Relying Party ID: the registrable domain the FRONTEND is served from,
# never a URL and never an IP address. It must equal the frontend hostname or
# be a parent of it. Defaults to "localhost" when DJANGO_DEBUG=True, which is
# why local sign-in must happen at http://localhost:3000 and not 127.0.0.1.
# Example for production: cultivatorscollective.co.za
DJANGO_WEBAUTHN_RP_ID=

# Shown by the authenticator when it asks the member to confirm.
DJANGO_WEBAUTHN_RP_NAME=Cultivators Collective

# Full frontend origins allowed to present credentials, comma-separated and
# scheme-included. Normally the same list as DJANGO_CORS_ALLOWED_ORIGINS.
# Defaults to http://localhost:3000 when DJANGO_DEBUG=True.
DJANGO_WEBAUTHN_ORIGINS=

# Sender address on the emailed sign-in codes.
DJANGO_DEFAULT_FROM_EMAIL=no-reply@cultivatorscollective.co.za

# Field-level encryption
# ----------------------
# Two independent 32-byte secrets, base64. Generate each with:
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep them out of source control and out of DJANGO_SECRET_KEY's rotation:
# rotating the secret key must not make stored ID numbers unreadable.

# Encrypts identity-document numbers at rest (AES-256-GCM).
# Lose it and every stored ID number is unrecoverable. There is no backup path.
DJANGO_FIELD_ENCRYPTION_KEY=

# Keys the searchable digests of ID numbers and email addresses. Changing it
# invalidates every stored digest, so the uniqueness check on ID numbers and
# the "has this address been seen before" lookup would both need a rebuild.
DJANGO_BLIND_INDEX_PEPPER=

# Club documents and the CDN
# --------------------------
# Where the documents a member agrees to are stored, and the address they are
# served from. Azure Blob Storage, fronted by the CDN. See documents/storage.py
# for the reader and documents/models.py for what is recorded per revision.
#
# Leave DJANGO_DOCUMENT_STORAGE_CONTAINER blank for local development: uploads
# then go to MEDIA_ROOT and runserver serves them, so the whole feature works
# with no Azure account at all. Everything else in this block is ignored while
# it is blank.

# Public prefix the CDN serves the documents from: scheme, host, and at most the
# container as its path. No trailing slash. Must be https anywhere but local
# development -- a document fetched over plain http is a document anything on the
# network path can rewrite.
#
# An Azure blob URL always carries the container as its first path segment, and
# only the host is swapped for this one. So if the path is set it must match the
# container name exactly, and startup fails if it does not -- otherwise every
# document link points at an address that does not exist.
# Example: https://qa-static.urup.com/consumer-collective
DJANGO_CDN_BASE_URL=

# The blob container the CDN fronts. Setting this switches uploads from local
# disk to Azure.
# Example: consumer-collective
DJANGO_DOCUMENT_STORAGE_CONTAINER=

# The storage account the container belongs to -- the name alone, not a URL.
# Required unless DJANGO_DOCUMENT_STORAGE_CONNECTION_STRING is set instead.
DJANGO_DOCUMENT_STORAGE_ACCOUNT=

# How to authenticate to that account. Pick one, in this order of preference:
#
# 1. Nothing at all. With an account set and no secret here, the container is
#    reached with a managed identity -- which is what QA and Production should
#    use. Assign the App Service identity the "Storage Blob Data Contributor"
#    role on the container; no secret goes into application settings, and there
#    is nothing to rotate.
#
# 2. An account key, for a developer writing against a real container. Grants
#    full control of the whole account, so keep it out of shared environments.
#
# 3. A SAS token, where a key is too much authority. Needs write permission on
#    the container, and expires -- uploads start failing the day it does.
#
# A connection string carries the account and the key together and overrides
# DJANGO_DOCUMENT_STORAGE_ACCOUNT. Convenient locally, a secret like any other.
DJANGO_DOCUMENT_STORAGE_ACCOUNT_KEY=
DJANGO_DOCUMENT_STORAGE_SAS_TOKEN=
DJANGO_DOCUMENT_STORAGE_CONNECTION_STRING=

# Blob-name prefix inside the container, for a container shared with other
# content. Normally blank: the documents already live under a "documents/"
# prefix of their own, which this would sit in front of.
DJANGO_DOCUMENT_STORAGE_LOCATION=

# Member avatars
# --------------
# Where a member's own photograph is stored. A *separate, private* container from
# the documents above, and the separation is the whole point: a club document is
# published to everybody, and an avatar is a photograph of somebody's face.
#
# There is deliberately no CDN variable in this block. The container has no public
# access and no SAS is minted, so an avatar has exactly one address --
# GET /api/accounts/me/avatar, which checks the session before it streams a byte.
# Startup fails if this names the same container as the documents, because that
# mistake would publish every member's photograph. See accounts/storage.py.
#
# Leave DJANGO_AVATAR_STORAGE_CONTAINER blank for local development: uploads then
# go to MEDIA_ROOT and the whole feature -- crop, upload, replace, serve -- works
# with no Azure account at all. Everything else in this block is ignored while it
# is blank.
#
# Note the local caveat: under DEBUG, runserver's static handler will serve a file
# from MEDIA_ROOT to anybody who guesses the path. Acceptable on a developer's
# machine and nowhere else -- a deployment either sets a private container here or
# puts a web server on MEDIA_URL that does not serve the avatars/ prefix.

# A private blob container, distinct from the documents one. Setting this switches
# avatar uploads from local disk to Azure.
# Example: consumer-collective-avatars
DJANGO_AVATAR_STORAGE_CONTAINER=

# The storage account the container belongs to -- the name alone, not a URL.
# Required unless DJANGO_AVATAR_STORAGE_CONNECTION_STRING is set instead.
DJANGO_AVATAR_STORAGE_ACCOUNT=

# How to authenticate, in the same order of preference as the documents block
# above and for the same reasons: nothing at all (managed identity, and what QA
# and Production should use), then an account key, then a SAS token.
DJANGO_AVATAR_STORAGE_ACCOUNT_KEY=
DJANGO_AVATAR_STORAGE_SAS_TOKEN=
DJANGO_AVATAR_STORAGE_CONNECTION_STRING=

# Blob-name prefix inside the container. Normally blank: avatars already live
# under an "avatars/" prefix of their own.
DJANGO_AVATAR_STORAGE_LOCATION=

# Payments: Payfast
# -----------------
# The membership subscription and the gateway that bills it. See app/payments/
# gateway.py for the reader that validates every variable below, and
# design/features/payments.md for what a payment does to an account.
#
# Leave DJANGO_PAYFAST_MERCHANT_ID and _KEY blank for local development: the
# reader then falls back to Payfast's own published sandbox merchant, so the
# whole flow works with no account at all. With DJANGO_DEBUG=False every
# variable here is required and Django refuses to start without it -- a payment
# integration that silently falls back to a sandbox is one that takes a
# member's money into an account nobody is watching.
#
# One thing configuration cannot fix locally: Payfast delivers notifications
# server-to-server and cannot reach a localhost notify URL, so the step that
# activates a membership never fires on a developer's machine. Use
#   manage.py payfast_notify --email someone@example.com
# which signs a real payload and runs it through the real verification.

# From the Payfast dashboard. The key is a secret and belongs in application
# settings, never in source control.
DJANGO_PAYFAST_MERCHANT_ID=
DJANGO_PAYFAST_MERCHANT_KEY=

# Set a passphrase on the Payfast account (Settings > Security) and put the same
# value here. Required, and not only for the signature: Payfast refuses
# subscriptions outright from a merchant that has none.
DJANGO_PAYFAST_PASSPHRASE=

# Which Payfast to talk to. Defaults to the sandbox when unset, in every
# environment -- live is never reached by leaving a variable blank. Set this to
# true only when the deployment means to take real money.
DJANGO_PAYFAST_SANDBOX=true

# Where Payfast sends the member's browser afterwards. Frontend addresses, and
# https anywhere but local development -- a payment redirect over plain http is
# one anything on the network path can rewrite.
DJANGO_PAYFAST_RETURN_URL=
DJANGO_PAYFAST_CANCEL_URL=

# Where Payfast notifies this application, server-to-server. Django's own public
# address, not the frontend's, and it must be reachable from the internet: this
# is the only thing that activates a membership.
DJANGO_PAYFAST_NOTIFY_URL=

# The frontend page a checkout token is paid from, without the token. The link
# emailed to a member with an outstanding payment is this plus their token.
DJANGO_MEMBERSHIP_CHECKOUT_URL=

# Set this only where the notification endpoint sits behind a reverse proxy that
# OVERWRITES X-Forwarded-For (Azure Front Door and Application Gateway both do).
# An origin that appends to whatever arrived lets a caller prepend an address of
# their choosing and walk straight through the source check, which is why
# reading that header is opt-in rather than automatic.
DJANGO_PAYFAST_BEHIND_PROXY=

# What a membership costs and how often it is billed. The amount is rands and
# cents; there is no free tier and 0 is refused. Frequency is one of monthly,
# quarterly, biannual, annual. Cycles is a whole number of billings, or 0 for
# "until the member cancels".
#
# Changing the amount changes what NEW members are asked for and nothing about
# what existing ones agreed to: the price is copied onto each subscription when
# it is opened. See app/payments/models.py.
DJANGO_MEMBERSHIP_SUBSCRIPTION_AMOUNT=150.00
DJANGO_MEMBERSHIP_SUBSCRIPTION_FREQUENCY=monthly
DJANGO_MEMBERSHIP_SUBSCRIPTION_CYCLES=0

# What the member sees on the Payfast page and on their bank statement. Says
# what it is and nothing about cultivation.
DJANGO_MEMBERSHIP_SUBSCRIPTION_ITEM_NAME=Club membership
DJANGO_MEMBERSHIP_SUBSCRIPTION_DESCRIPTION=Cultivators Collective membership subscription
