# Everything the six container apps read, for one environment.
#
# Copy this to `deploy/qa.values.env` (or `uat`, `prod`) and fill in every
# value, then pass the path as VALUES_FILE to `deploy/provision-key-vault.sh`
# and then to `deploy/provision-container-apps.sh`. **The copy carries
# passwords and the two encryption keys, so it is `.gitignore`d and must never
# be committed.** Delete it once the apps exist -- the values live on the
# container apps and in the vault from then on, and Azure is where they should
# be read back from.
#
# The source of truth for every value here is design/deploy-quickstart.md,
# Tables B to E. Where this file says QA, it means the QA column of those
# tables.
#
# The script refuses to run with any of these empty rather than creating an app
# that cannot start, so an unfilled line is caught here rather than in a
# crashlooping container.
#
# **Quote any value containing a space, a bracket, a `#` or a `$`.** This file
# is sourced, so `NAME=Club membership` runs `membership` as a command and the
# variable keeps only the first word. Single quotes throughout is the safe
# habit; the three values below that need them already have them.
#
# **Two failures worth recognising, because neither names the line it is on in
# an obvious way.** A `(` or a `{` in an unquoted password is a syntax error
# that fails the whole file -- `syntax error near unexpected token '('` -- and
# the line number in that message is the one to look at. And filling in a value
# on a line like `NAME=            # comment` while deleting the `#` turns the
# rest of the guidance into a command: `--: command not found`, with the
# variable set correctly and the script dead anyway.

# ==========================================================================
# The data tier
#
# **The database, cache and storage account are in different resource groups
# from the container apps in this subscription, and nothing here needs to know
# that.** The API reaches MySQL by hostname, Redis by URL and blob storage by
# account name. Only the provisioning script's preflight cares, and it takes
# MYSQL_RESOURCE_GROUP, REDIS_RESOURCE_GROUP and STORAGE_RESOURCE_GROUP for it.
# ==========================================================================

# MySQL Flexible Server 8.4. `require_secure_transport` stays ON, so the
# connection is encrypted either way -- but it is **not** certificate-verified
# here, and that is a decision rather than an oversight.
#
# f2c/database.py refuses a deployment that names neither a CA bundle nor an
# explicit disable, because mysqlclient's own default is to downgrade silently.
# This deployment says `DJANGO_DB_SSL_DISABLED=true` and takes the second of
# those. The name is misleading and worth reading carefully: it turns off
# certificate *verification*, not encryption. With it set, `tls_options`
# returns nothing, mysqlclient applies `ssl_mode=PREFERRED`, and the connection
# still comes up over TLS -- it simply does not check which server answered.
#
# What carries the trust instead: the Flexible Server firewall admits only
# Azure services and a named list of office IPs, and the application user
# authenticates with a password held as a container app secret. No route to the
# server exists from the open internet for a man in the middle to sit on.
#
# **To restore verification**, clear DJANGO_DB_SSL_DISABLED and set
# `DJANGO_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt`. That path already
# exists in the runtime image and already carries the DigiCert roots Flexible
# Server chains to, so the change is one line and needs nothing mounted.
#
# QA is `qa-urupconnect.mysql.database.azure.com`, MySQL 8.4, in the
# `qa-urupconnect` resource group -- not this environment's own. UAT is
# `uat-urupconnect` in `uc-uat`, also 8.4. **Production is `prod-urupconnect` in
# `prod-urupconnect-rg` and reports 8.0.21**, which clears the 8.0.16 floor
# `app/core/common/checks.py` enforces but is not the version CI proves the
# schema against -- design/backend.md risk 14 is about exactly that gap.
DJANGO_DB_HOST=                     # qa-urupconnect.mysql.database.azure.com
DJANGO_DB_PORT=3306
DJANGO_DB_NAME=f2c
DJANGO_DB_USER=                     # the application user, not the admin
DJANGO_DB_PASSWORD=                 # SECRET
DJANGO_DB_SSL_DISABLED=true          # verification off; see above

# **Redis is not configured here, and must not be.**
#
# `provision-container-apps.sh` runs it as a container app in the environment
# itself and sets `DJANGO_REDIS_URL` and `DJANGO_CACHE_ALLOW_PLAINTEXT` from
# what it created. Setting either in this file is refused rather than silently
# overridden, because the URL names an app at the managed environment's internal
# domain and that domain does not exist until the environment does.
#
# The reasoning is in that script's header. In short: `f2c/queue.py` puts the
# broker on database 1 of the cache's instance and Azure Managed Redis exposes
# one database per cluster; the instance available here is `OSSCluster` and
# kombu has no Redis Cluster transport; and its access keys are disabled while
# neither `f2c/cache.py` nor `f2c/queue.py` can present an Entra token. A plain
# Redis has sixteen databases and none of those three problems.
#
# A per-process cache would turn every published rate limit into that limit
# times the replica count, silently, which is the fault f2c/cache.py exists to
# prevent -- so one shared instance still matters, container or managed.

# Two blob containers, and they may not be merged: `avatars_storage_config`
# refuses a configuration where the avatar container equals the document one.
# The documents container is fronted by a CDN and serves unsigned, permanently
# cacheable URLs; an avatar is only ever streamed by an endpoint that checked
# the session first. Putting them together publishes every member's photograph.
#
# No account key, SAS token or connection string. The API reaches blob storage
# with the user-assigned identity from deploy/provision-key-vault.sh, which
# grants it Storage Blob Data Contributor on both accounts named here.
#
# **AZURE_CLIENT_ID is not on this file and must not be added.** The
# provisioning script derives it from USER_IDENTITY and refuses a value for it
# here, alongside DJANGO_REDIS_URL and DJANGO_CACHE_ALLOW_PLAINTEXT.
DJANGO_DOCUMENT_STORAGE_ACCOUNT=    # e.g. stf2cqaweu
DJANGO_DOCUMENT_STORAGE_CONTAINER=  # e.g. cc-documents-qa
DJANGO_AVATAR_STORAGE_ACCOUNT=      # e.g. stf2cqaweu
DJANGO_AVATAR_STORAGE_CONTAINER=    # e.g. cc-avatars-qa  -- must differ

# ==========================================================================
# Django, and the keys it will not start without
# ==========================================================================

# `qa`, `uat` or `prod` -- **prod, not production**. A different vocabulary
# from APP_ENV below, deliberately.
DJANGO_ENV=qa
DJANGO_DEBUG=False

# Generated, 32 bytes and base64 for the two encryption keys -- see
# common/crypto.py. Losing either is unrecoverable, which is why the two go to
# Key Vault and DJANGO_SECRET_KEY does not: design/deploy.md 3.1.
#
# **The two encryption keys are read from here once, by
# deploy/provision-key-vault.sh, and then belong in the vault.** The container
# apps carry a keyvaultref rather than a copy, so once that script has run this
# file is the only remaining plaintext -- delete both lines.
DJANGO_SECRET_KEY=                  # SECRET
DJANGO_FIELD_ENCRYPTION_KEY=        # SECRET, to Key Vault
DJANGO_BLIND_INDEX_PEPPER=          # SECRET, to Key Vault

# API hostnames, comma-separated, no scheme.
DJANGO_ALLOWED_HOSTS=               # qa-api.f2c-cannabis.co.za,qa-api.f2c.co.za

# **`true`, and it is not optional.** Container Apps ingress is a reverse proxy,
# so REMOTE_ADDR is Envoy. Without this no Payfast notification is accepted and
# no membership activates.
DJANGO_BEHIND_PROXY=true

# Frontend origins, with scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=        # https://qa.f2c-cannabis.co.za,https://qa.f2c.co.za
DJANGO_CORS_ALLOWED_ORIGINS=        # https://qa.f2c-cannabis.co.za,https://qa.f2c.co.za

# Which API hostname serves which storefront. **API hostnames, not frontend
# ones.**
DJANGO_STOREFRONT_HOSTS=            # qa-api.f2c-cannabis.co.za=club,qa-api.f2c.co.za=market
DJANGO_DEFAULT_STOREFRONT=club

# WebAuthn, and from here down the hostnames are the **frontend** ones. An RP ID
# that does not match the origin the browser is on makes every passkey
# unusable.
DJANGO_WEBAUTHN_RP_ID=              # qa.f2c-cannabis.co.za
DJANGO_WEBAUTHN_RP_IDS=             # club=qa.f2c-cannabis.co.za,market=qa.f2c.co.za
DJANGO_WEBAUTHN_RP_NAME=            # 'Cultivators Collective (QA)' -- quote it: it has spaces and brackets
DJANGO_WEBAUTHN_ORIGINS=            # https://qa.f2c-cannabis.co.za,https://qa.f2c.co.za

# ==========================================================================
# Email
#
# Two mailboxes, two blocks, and **the API does not boot without the F2C block
# whether or not the market storefront is deployed** -- `_mailer` refuses a
# deployed environment naming only one.
# ==========================================================================

DJANGO_DEFAULT_FROM_EMAIL=          # no-reply@f2c-cannabis.co.za

EMAIL_CC_HOST=
EMAIL_CC_PORT=587
EMAIL_CC_USER=
EMAIL_CC_PASSWORD=                  # SECRET
EMAIL_CC_USE_TLS=true
EMAIL_CC_FROM=                      # required -- no useful fallback

EMAIL_F2C_HOST=                     # mail.f2c.co.za
EMAIL_F2C_PORT=587
EMAIL_F2C_USER=
EMAIL_F2C_PASSWORD=                 # SECRET
EMAIL_F2C_USE_TLS=true
EMAIL_F2C_FROM=

EMAIL_DISPATCH_RETENTION_DAYS=365
CAMPAIGN_TOUCH_RETENTION_DAYS=730

# ==========================================================================
# Payfast
#
# Sandbox in QA and UAT, live in production.
# ==========================================================================

DJANGO_PAYFAST_SANDBOX=true
DJANGO_PAYFAST_MERCHANT_ID=         # SECRET
DJANGO_PAYFAST_MERCHANT_KEY=        # SECRET

# **Required, not optional** -- Payfast refuses subscriptions from a merchant
# without one.
DJANGO_PAYFAST_PASSPHRASE=          # SECRET

DJANGO_PAYFAST_RETURN_URL=          # https://qa.f2c-cannabis.co.za/signup/paid
DJANGO_PAYFAST_CANCEL_URL=          # https://qa.f2c-cannabis.co.za/signup/cancelled

# **The API address, and internet-reachable.** This is where Payfast's own
# servers post; a notification that does not arrive is a member who paid and was
# not switched on.
DJANGO_PAYFAST_NOTIFY_URL=          # https://qa-api.f2c-cannabis.co.za/api/payments/payfast/notify

DJANGO_MEMBERSHIP_CHECKOUT_URL=     # https://qa.f2c-cannabis.co.za/pay
DJANGO_MEMBERSHIP_SUBSCRIPTION_AMOUNT=150.00
DJANGO_MEMBERSHIP_SUBSCRIPTION_FREQUENCY=monthly
DJANGO_MEMBERSHIP_SUBSCRIPTION_CYCLES=0
DJANGO_MEMBERSHIP_SUBSCRIPTION_ITEM_NAME='Club membership'
DJANGO_MEMBERSHIP_SUBSCRIPTION_DESCRIPTION='Cultivators Collective membership subscription'

# ==========================================================================
# The club storefront -- Table D
#
# There are no build arguments. The image is the same one in every environment,
# and this block is what makes it a QA one (R-D4). The container refuses to
# start without SITE_URL, APP_ENV, CDN_BASE_URL or SUPPORT_EMAIL and names the
# missing one in its log -- frontend/deploy/entrypoint.sh.
# ==========================================================================

# The API's in-environment address, used for server-side rendering. Container
# Apps gives an externally-exposed app one FQDN; use the app's own FQDN, or the
# public hostname once the custom domain resolves.
DJANGO_API_URL=

# Same registrable domain as SITE_URL, or the browser drops the cookies.
DJANGO_API_PUBLIC_URL=              # https://qa-api.f2c-cannabis.co.za

SITE_URL=                           # https://qa.f2c-cannabis.co.za -- scheme and host only, no path
APP_ENV=qa                          # local, qa or production. Decides indexing
CDN_BASE_URL=                       # static host, https outside local development
SUPPORT_EMAIL=                      # members@f2c-cannabis.co.za -- the mailbox on the blocked-membership screen
PORT=3000

# ==========================================================================
# The market storefront -- Table E
#
# MARKET_-prefixed because both storefronts read the same two variable names
# with different values; the script maps these on to SITE_URL and
# DJANGO_API_PUBLIC_URL when it creates the market app. DJANGO_API_URL, APP_ENV
# and PORT are shared with the club above.
#
# No CDN_BASE_URL and no SUPPORT_EMAIL: the club film and the
# blocked-membership screen are both the club's. Skip this block entirely with
# SKIP_MARKET=1.
# ==========================================================================

MARKET_SITE_URL=                    # https://qa.f2c.co.za
MARKET_DJANGO_API_PUBLIC_URL=       # https://qa-api.f2c.co.za

# ==========================================================================
# Leave unset, every one of them
#
# Each downgrades or overrides something that is correct as it stands:
#
#   DJANGO_CACHE_ALLOW_PLAINTEXT    permits redis:// where rediss:// is required
#   EMAIL_CC_USE_SSL                conflicts with USE_TLS on port 587
#   EMAIL_F2C_USE_SSL
#   DJANGO_CDN_BASE_URL             blank unless the documents container is
#                                   actually fronted; if set, https, and its
#                                   path empty or exactly the container name
#   every storage account key, SAS token and connection string
# ==========================================================================
